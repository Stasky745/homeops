clusterName: <cluster-name>
talosVersion: v1.13.8
kubernetesVersion: v1.36.1
endpoint: https://<vip-ip>:6443
allowSchedulingOnControlPlanes: true

# CNI is managed by Cilium, deployed via Flux
cniConfig:
  name: none

patches:
  - |-
    cluster:
      proxy:
        disabled: true
      etcd:
        # MANDATORY. Without this, etcd registers on Cilium's cilium_host IPs,
        # which are only reachable over VXLAN — switching to native routing then
        # deadlocks etcd with no recovery path short of a full re-bootstrap.
        advertisedSubnets:
          - <node-subnet-cidr>
        # Default listener is loopback-only, so in-cluster scrapes find no target.
        extraArgs:
          listen-metrics-urls: http://0.0.0.0:2381
      # Both default to 127.0.0.1, making their metrics unscrapable from a pod.
      # The ports stay authenticated — authz is delegated to the apiserver.
      controllerManager:
        extraArgs:
          bind-address: 0.0.0.0
      scheduler:
        extraArgs:
          bind-address: 0.0.0.0
    machine:
      kernel:
        modules:
          - name: iscsi_tcp
          - name: dm_crypt
          - name: rbd
          - name: i915
      kubelet:
        # MANDATORY, same reason as advertisedSubnets above.
        nodeIP:
          validSubnets:
            - <node-subnet-cidr>
      sysctls:
        vm.max_map_count: "262144"
      network:
        nameservers:
          - <nameserver-ip>
      time:
        servers:
          - <ntp-server-ip>

nodes:
  - hostname: <node-1-hostname>
    ipAddress: <node-1-ip>
    controlPlane: true
    installDisk: /dev/<disk>
    talosImageURL: factory.talos.dev/installer/<schematic-id>
    networkInterfaces:
      - interface: <interface-name>
        dhcp: false
        addresses:
          - <node-1-ip>/<prefix-length>
        routes:
          - network: 0.0.0.0/0
            gateway: <gateway-ip>
        vip:
          ip: <vip-ip>

  - hostname: <node-2-hostname>
    ipAddress: <node-2-ip>
    controlPlane: true
    installDisk: /dev/<disk>
    talosImageURL: factory.talos.dev/installer/<schematic-id>
    networkInterfaces:
      - interface: <interface-name>
        dhcp: false
        addresses:
          - <node-2-ip>/<prefix-length>
        routes:
          - network: 0.0.0.0/0
            gateway: <gateway-ip>
        vip:
          ip: <vip-ip>

  - hostname: <node-3-hostname>
    ipAddress: <node-3-ip>
    controlPlane: true
    installDisk: /dev/<disk>
    talosImageURL: factory.talos.dev/installer/<schematic-id>
    networkInterfaces:
      - interface: <interface-name>
        dhcp: false
        addresses:
          - <node-3-ip>/<prefix-length>
        routes:
          - network: 0.0.0.0/0
            gateway: <gateway-ip>
        vip:
          ip: <vip-ip>
